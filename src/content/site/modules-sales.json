          "tabs": [
            {
              "title": "هل الفواتير متوافقة مع المرحلة الثانية؟",
              "html": "<p>نعم، تُصدر فواتير إلكترونية متوافقة برمز QR.</p>"
            },
            {
              "title": "هل القوالب احترافية وثنائية اللغة؟",
              "html": "<p>نعم، قوالب طباعة أنيقة بالعربية والإنجليزية.</p>"
            },
            {
              "title": "هل يرتبط بالمتجر الإلكتروني؟",
              "html": "<p>يدعم استقبال الطلبات من المتجر حسب توفّر التكامل.</p>"
            },
            {
              "title": "هل أتابع التحصيل؟",
              "html": "<p>نعم، تذكيرات وتقرير أعمار ذمم للعملاء.</p>"
            },
            {
              "title": "هل يخصم المخزون تلقائيًا؟",
              "html": "<p>نعم، الفاتورة تخصم المخزون وتُنشئ القيد تلقائيًا.</p>"
            }
          ]
        }
      ]
    },
