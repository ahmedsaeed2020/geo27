                  "id": "3395a52e",
                  "type": "html",
                  "className": "in-3395a52e ",
                  "anchor": "",
                  "html": "<div class=\"is-162\"><span class=\"is-163\">اختر النوع</span><span class=\"is-164\">←</span><span class=\"is-165\">حدّد الفلاتر</span><span class=\"is-166\">←</span><span class=\"is-167\">جمّع البيانات</span><span class=\"is-168\">←</span><span class=\"is-169\">احفظ التقرير</span><span class=\"is-170\">←</span><span class=\"is-171\">صدّر أو جدوِل</span></div>"
