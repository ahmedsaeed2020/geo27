:[{"id":"5f0dd2a6","type":"container","className":"in-5f0dd2a6 ","anchor":"","children":[{"id":"68db8168","type":"text-editor","className":"in-68db8168 ","anchor":"","html":"أسئلة متكررة"},{"id":"5039128d","type":"heading","className":"in-5039128d ","anchor":"","html":"أسئلة فريق المحاسبة قبل القرار","tag":"h2"},{"id":"2dc51da1","type":"text-editor","className":"in-2dc51da1 ","anchor":"","html":"إجابات صريحة على أكثر ما يشغل المحاسب والمدير المالي."}]},{"id":"133ddd3c","type":"accordion","className":"in-133ddd3c qa","anchor":"","tabs":[{"title":"هل يدعم النظام ضريبة القيمة المضافة بصيغة الهيئة؟","html":"<p>نعم، يُصدر تقرير ضريبة القيمة المضافة منظّمًا بالشكل المطلوب لتسهيل التقديم.</p>"},{"title":"هل أحتاج محاسبًا أو مستشارًا لإخراج التقارير؟","html":"<p>لا، التقارير المالية جاهزة بالعربية ويمكن لفريقك الوصول إليها مباشرة دون كتابة أي كود.</p>"},{"title":"هل يوجد سجل تدقيق لكل عملية؟","html":"<p>نعم، كل مستند يحتفظ بسجل تدقيق كامل يوضّح التغييرات والمستخدمين والتواريخ.</p>"},{"title":"هل شجرة الحسابات سعودية وجاهزة؟","html":"<p>نعم، تأتي بشجرة حسابات سعودية جاهزة يمكن تعديلها حسب نشاطك.</p>"},{"title":"هل يمكن توزيع المصروفات على الفروع والمشاريع؟","html":"<p>نعم، عبر مراكز التكلفة والأبعاد التحليلية ترى الربحية لكل فرع ومشروع وقسم.</p>"},{"title":"هل يرتبط النظام ببنوك سعودية؟","html":"<p>يدعم النظام التسوية البنكية ومتابعة الحركات، ويعتمد الربط البنكي المباشر على توفّر التكامل في الباقة أو التنفيذ.</p>"},{"title":"هل يوجد تدريب ودعم بالعربية؟","html":"<p>نعم، تدريب عربي عند التشغيل ودعم فني وقاعدة معرفة بالعربية.</p>"},{"title":"هل أرى تفاصيل كل رقم في التقارير؟","html":"<p>نعم، يمكن الوصول من الأرقام إلى تفاصيلها حسب إعداد التقارير والصلاحيات، ومركز التقارير يجمع تقاريرك بالعربية في مكان واحد.</p>"}]}]},{"id":"36cc95e9","type":"container","className":"in-36cc95e9 digit related","anchor":"","children":[{"id":"304554b4","type":"container","className":"in-304554b4 ","anchor":"","children":[{"id":"6de2f1a0","type":"text-editor","className":"in-6de2f1a0 ","anchor":"",