     "className": "in-7338d4a0 qa",
     "anchor": "",
     "tabs": [
      {
       "title": "هل الإهلاك تلقائي؟",
       "html": "<p>نعم، جداول إهلاك دورية تلقائية وفق سياسة كل فئة.</p>"
      },
      {
       "title": "هل يعالج البيع والاستبعاد؟",
       "html": "<p>نعم، مع احتساب الربح أو الخسارة وقيوده.</p>"
      },
      {
       "title": "هل يتابع الصيانة؟",
       "html": "<p>نعم، مواعيد وتكاليف صيانة الأصول.</p>"
      },
      {
       "title": "هل يرتبط بالمحاسبة؟",
       "html": "<p>نعم، كل حركة أصل تُنشئ قيدها تلقائيًا.</p>"
      }
     ]
    }
   ]
  },
