{"name":"Notification","app":"frappe","module":"Email","istable":0,"issingle":0,"is_submittable":0,"is_tree":0,"autoname":"Prompt","title_field":"subject","search_fields":null,"sort_field":"creation","fields":[{"fieldname":"enabled","fieldtype":"Check","label":"Enabled","default":"1"},{"fieldname":"is_standard","fieldtype":"Check","label":"Is Standard","default":"0","no_copy":1},{"fieldname":"module","fieldtype":"Link","label":"Module","options":"Module Def","depends_on":"is_standard","in_standard_filter":1},{"fieldname":"column_break_2","fieldtype":"Column Break"},{"fieldname":"channel","fieldtype":"Select","label":"Channel","options":"Email\nSlack\nSystem Notification\nSMS","reqd":1,"depends_on":"eval: !doc.disable_channel","default":"Email"},{"fieldname":"slack_webhook_url","fieldtype":"Link","label":"Slack Channel","options":"Slack Webhook URL","depends_on":"eval:doc.channel=='Slack'","mandatory_depends_on":"eval:doc.channel=='Slack'","description":"To use Slack Channel, add a <a href=\"#List/Slack%20Webhook%20URL/List\" rel=\"noopener noreferrer\">Slack Webhook URL</a>."},{"fieldname":"filters_section","fieldtype":"Section Break","label":"Filters"},{"fieldname":"event","fieldtype":"Select","label":"Send Alert On","options":"\nNew\nSave\nSubmit\nCancel\nDays After\nDays Before\nMinutes After\nMinutes Before\nValue Change\nMethod","reqd":1,"in_list_view":1},{"fieldname":"document_type","fieldtype":"Link","label":"Document Type","options":"DocType","reqd":1,"in_list_view":1,"in_standard_filter":1},{"fieldname":"col_break_1","fieldtype":"Column Break"},{"fieldname":"method","fieldtype":"Data","label":"Trigger Method","depends_on":"eval:doc.event=='Method'","description":"Trigger on valid methods like \"before_insert\", \"after_update\", etc (will depend on the DocType selected)"},{"fieldname":"date_changed","fieldtype":"Select","label":"Reference Date","depends_on":"eval:doc.document_type && (doc.event==\"Days After\" || doc.event==\"Days Before\")","description":"Send alert if date matches this field's value"},{"fieldname":"datetime_changed","fieldtype":"Select","label":"Reference Datetime","depends_on":"eval:doc.document_type && (doc.event==\"Minutes After\" || doc.event==\"Minutes Before\")","description":"Send alert if datetime matches this field's value"},{"fieldname":"days_in_advance","fieldtype":"Int","label":"Days Before or After","depends_on":"eval:doc.document_type && (doc.event==\"Days After\" || doc.event==\"Days Before\")","default":"0","description":"Send days before or after the reference date"},{"fieldname":"minutes_offset","fieldtype":"Int","label":"Minutes Offset","depends_on":"eval:doc.document_type && (doc.event==\"Minutes After\" || doc.event==\"Minutes Before\")","default":"0","description":"Send <b>at the earliest</b> this number of minutes before or after the reference datetime. The actual sending may be delayed by up to 5 minutes due to the scheduler's trigger cadence."},{"fieldname":"datetime_last_run","fieldtype":"Datetime","label":"Last Run","read_only":1,"depends_on":"eval:doc.document_type && (doc.event==\"Minutes After\" || doc.event==\"Minutes Before\")"},{"fieldname":"value_changed","fieldtype":"Select","label":"Value Changed","depends_on":"eval:doc.document_type && doc.event==\"Value Change\"","description":"Send alert if this field's value changes"},{"fieldname":"sender","fieldtype":"Link","label":"Sender","options":"Email Account","depends_on":"eval: doc.channel == 'Email'"},{"fieldname":"send_system_notification","fieldtype":"Check","label":"Send System Notification","depends_on":"eval: doc.channel !== 'System Notification'","default":"0","description":"If enabled, the notification will show up in the notifications dropdown on the top right corner of the navigation bar."},{"fieldname":"notification_type","fieldtype":"Link","label":"Notification Type","options":"Notification Type","depends_on":"eval: doc.channel === 'System Notification' || doc.send_system_notification","default":"Alert","description":"Category for the in-app notification. Used for filtering and per-user email preferences."},{"fieldname":"sender_email","fieldtype":"Data","label":"Sender Email","options":"Email","read_only":1},{"fieldname":"section_break_9","fieldtype":"Section Break"},{"fieldname":"condition_type","fieldtype":"Select","label":"Condition Type","options":"Python\nFilters","default":"Python"},{"fieldname":"filters_editor","fieldtype":"HTML","label":"Filters Editor","depends_on":"eval:doc.condition_type===\"Filters\""},{"fieldname":"condition","fieldtype":"Code","label":"Condition","depends_on":"eval:doc.condition_type===\"Python\"","in_list_view":1,"description":"Optional: The alert will be sent if this expression is true"},{"fieldname":"filters","fieldtype":"Code","label":"Filters","options":"JSON","hidden":1,"read_only":1},{"fieldname":"column_break_6","fieldtype":"Column Break"},{"fieldname":"html_7","fieldtype":"HTML","options":"<p><strong>{{ __(\"Condition Examples\") }}:</strong></p>\n<pre><code class=\"language-python\">doc.status==\"Open\"<br>doc.due_date==nowdate()<br>doc.total &gt; 40000\n</code></pre>\n","depends_on":"eval:doc.condition_type===\"Python\""},{"fieldname":"property_section","fieldtype":"Section Break","label":"Set Property After Alert","collapsible":1},{"fieldname":"set_property_after_alert","fieldtype":"Select","label":"Set Property After Alert"},{"fieldname":"property_value","fieldtype":"Data","label":"Value To Be Set"},{"fieldname":"column_break_5","fieldtype":"Section Break","label":"Recipients","depends_on":"eval:doc.channel !=\"Slack\""},{"fieldname":"send_to_all_assignees","fieldtype":"Check","label":"Send To All Assignees","depends_on":"eval:doc.channel == 'Email'","default":"0"},{"fieldname":"recipients","fieldtype":"Table","label":"Recipients","options":"Notification Recipient","mandatory_depends_on":"eval:doc.channel!=='Slack' && !doc.send_to_all_assignees"},{"fieldname":"message_sb","fieldtype":"Section Break","label":"Content"},{"fieldname":"email_template","fieldtype":"Link","label":"Email Template","options":"Email Template","depends_on":"eval: doc.channel == 'Email'","description":"Send this notification's content from an Email Template instead of Subject/Message."},{"fieldname":"subject","fieldtype":"Data","label":"Subject","depends_on":"eval: in_list(['Email', 'Slack', 'System Notification'], doc.channel) && !doc.email_template","mandatory_depends_on":"eval: in_list(['Email', 'Slack', 'System Notification'], doc.channel) && !doc.email_template","in_list_view":1,"description":"For a dynamic subject, use Jinja tags like this: <code>{{ doc.name }} Delivered</code>"},{"fieldname":"message_type","fieldtype":"Select","label":"Message Type","options":"Markdown\nHTML\nPlain Text","depends_on":"is_standard","default":"Markdown"},{"fieldname":"message","fieldtype":"Code","label":"Message","options":"Jinja","depends_on":"eval: !doc.email_template","default":"Add your message here"},{"fieldname":"message_examples","fieldtype":"HTML","label":"Message Examples","options":"<h5>Message Example</h5>\n\n<pre>&lt;h3&gt;Order Overdue&lt;/h3&gt;\n\n&lt;p&gt;Transaction {{ doc.name }} has exceeded Due Date. Please take necessary action.&lt;/p&gt;\n\n&lt;!-- show last comment --&gt;\n{% if comments %}\nLast comment: {{ comments[-1].comment }} by {{ comments[-1].by }}\n{% endif %}\n\n&lt;h4&gt;Details&lt;/h4&gt;\n\n&lt;ul&gt;\n&lt;li&gt;Customer: {{ doc.customer }}\n&lt;li&gt;Amount: {{ doc.grand_total }}\n&lt;/ul&gt;\n</pre>"},{"fieldname":"view_properties","fieldtype":"Button","label":"View Properties (via Customize Form)"},{"fieldname":"column_break_25","fieldtype":"Section Break","label":"Attachment Settings","collapsible":1,"collapsible_depends_on":"attach_print"},{"fieldname":"attach_print","fieldtype":"Check","label":"Attach Print","default":"0"},{"fieldname":"print_format","fieldtype":"Link","label":"Print Format","options":"Print Format","depends_on":"attach_print"},{"fieldname":"column_break_llcs","fieldtype":"Column Break"},{"fieldname":"attach_files","fieldtype":"Select","label":"Attach Files","options":"\nFrom Field\nAll"},{"fieldname":"from_attach_field","fieldtype":"Select","label":"From Attach Field","depends_on":"eval:doc.attach_files === \"From Field\"","mandatory_depends_on":"eval:doc.attach_files === \"From Field\""}],"permissions":[{"create":1,"delete":1,"read":1,"role":"System Manager","write":1}],"links":[],"source":"frappe/frappe-develop/frappe/email/doctype/notification/notification.json","modified":"2026-09-16 15:32:23.104030"}