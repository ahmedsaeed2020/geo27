{"name":"Social Login Key","app":"frappe","module":"Integrations","istable":0,"issingle":0,"is_submittable":0,"is_tree":0,"autoname":null,"title_field":"provider_name","search_fields":null,"sort_field":"creation","fields":[{"fieldname":"enable_social_login","fieldtype":"Check","label":"Enable Social Login","default":"0"},{"fieldname":"client_credentials","fieldtype":"Section Break","label":"Client Credentials","collapsible":1,"collapsible_depends_on":"eval:doc.enable_social_login"},{"fieldname":"social_login_provider","fieldtype":"Select","label":"Social Login Provider","options":"Custom\nFacebook\nFrappe\nGitHub\nGoogle\nOffice 365\nSalesforce\nfairlogin\nKeycloak","depends_on":"eval:doc.custom!=1","default":"Custom"},{"fieldname":"client_id","fieldtype":"Data","label":"Client ID"},{"fieldname":"column_break_0","fieldtype":"Column Break"},{"fieldname":"provider_name","fieldtype":"Data","label":"Provider Name","reqd":1,"in_list_view":1},{"fieldname":"client_secret","fieldtype":"Password","label":"Client Secret"},{"fieldname":"sb_identity_details","fieldtype":"Section Break","label":"Identity Details","collapsible":1,"collapsible_depends_on":"eval:doc.custom_base_url"},{"fieldname":"icon","fieldtype":"Data","label":"Icon","depends_on":"eval:doc.social_login_provider==\"Custom\""},{"fieldname":"column_break_1","fieldtype":"Column Break"},{"fieldname":"base_url","fieldtype":"Data","label":"Base URL"},{"fieldname":"configuration_section","fieldtype":"Section Break","label":"Configuration","collapsible":1},{"fieldname":"sign_ups","fieldtype":"Select","label":"Sign ups","options":"\nAllow\nDeny","description":"Controls whether new users can sign up using this Social Login Key. If unset, Website Settings is respected."},{"fieldname":"show_in_resource_metadata","fieldtype":"Check","label":"Show in Resource Metadata","default":"1","description":"Allows clients to view this as an Authorization Server when querying the <code>/.well-known/oauth-protected-resource</code> end point."},{"fieldname":"trust_email_without_verified_claim","fieldtype":"Check","label":"Trust Email Without Verified Claim","default":"0","description":"Only enable this if you trust this provider's user accounts to be legitimate even when it omits the <code>email_verified</code> claim entirely (e.g. a self-hosted identity provider where email verification isn't enforced). This does not override a provider that explicitly sends <code>email_verified: false</code> \u2014 that login is always rejected."},{"fieldname":"trust_any_tenant","fieldtype":"Check","label":"Trust Any Tenant (Insecure)","depends_on":"eval:doc.social_login_provider===\"Office 365\"","default":"0","description":"Allow sign-in from any Entra tenant, not just Tenant ID. Only enable this if you trust every Entra tenant to accurately identify its users."},{"fieldname":"tenant_id","fieldtype":"Data","label":"Tenant ID","depends_on":"eval:doc.social_login_provider===\"Office 365\"","description":"Restrict Office 365 sign-in to this Entra tenant ID. Required unless \"Trust Any Tenant\" is checked."},{"fieldname":"client_urls","fieldtype":"Section Break","label":"Client URLs","collapsible":1,"collapsible_depends_on":"eval:doc.social_login_provider===\"Custom\""},{"fieldname":"authorize_url","fieldtype":"Data","label":"Authorize URL"},{"fieldname":"access_token_url","fieldtype":"Data","label":"Access Token URL"},{"fieldname":"column_break_3","fieldtype":"Column Break"},{"fieldname":"redirect_url","fieldtype":"Data","label":"Redirect URL"},{"fieldname":"api_endpoint","fieldtype":"Data","label":"API Endpoint"},{"fieldname":"custom_base_url","fieldtype":"Check","label":"Custom Base URL","hidden":1,"default":"0"},{"fieldname":"client_information","fieldtype":"Section Break","label":"Client Information","collapsible":1,"collapsible_depends_on":"eval:doc.social_login_provider===\"Custom\""},{"fieldname":"api_endpoint_args","fieldtype":"Code","label":"API Endpoint Args"},{"fieldname":"auth_url_data","fieldtype":"Code","label":"Auth URL Data"},{"fieldname":"user_id_property","fieldtype":"Data","label":"User ID Property","depends_on":"eval:doc.social_login_provider===\"Custom\""}],"permissions":[{"create":1,"delete":1,"read":1,"role":"System Manager","write":1}],"links":[],"source":"frappe/frappe-develop/frappe/integrations/doctype/social_login_key/social_login_key.json","modified":"2026-09-07 20:16:36.820751"}