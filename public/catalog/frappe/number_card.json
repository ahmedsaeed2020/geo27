{"name":"Number Card","app":"frappe","module":"Desk","istable":0,"issingle":0,"is_submittable":0,"is_tree":0,"autoname":null,"title_field":"label","search_fields":"label, document_type","sort_field":"creation","fields":[{"fieldname":"is_standard","fieldtype":"Check","label":"Is Standard","read_only_depends_on":"eval: !frappe.boot.developer_mode","default":"0","no_copy":1},{"fieldname":"module","fieldtype":"Link","label":"Module","options":"Module Def","depends_on":"eval: doc.is_standard","mandatory_depends_on":"eval: doc.is_standard"},{"fieldname":"label","fieldtype":"Data","label":"Label","reqd":1,"in_list_view":1},{"fieldname":"type","fieldtype":"Select","label":"Type","options":"Document Type\nReport\nCustom"},{"fieldname":"report_name","fieldtype":"Link","label":"Report Name","options":"Report","depends_on":"eval: doc.type == 'Report'","mandatory_depends_on":"eval: doc.type == 'Report'"},{"fieldname":"method","fieldtype":"Data","label":"Method","depends_on":"eval: doc.type == 'Custom'","mandatory_depends_on":"eval: doc.type == 'Custom'","description":"Set the path to a whitelisted function that will return the data for the number card in the format:\n\n<pre class=\"small text-muted\"><code>\n{\n\t\"value\": value,\n\t\"fieldtype\": \"Currency\",\n\t\"route_options\": {\"from_date\": \"2023-05-23\"},\n\t\"route\": [\"query-report\", \"Permitted Documents For User\"]\n}</code></pre>"},{"fieldname":"function","fieldtype":"Select","label":"Function","options":"Count\nSum\nAverage\nMinimum\nMaximum","depends_on":"eval: doc.type == 'Document Type'","mandatory_depends_on":"eval: doc.type == 'Document Type'"},{"fieldname":"aggregate_function_based_on","fieldtype":"Select","label":"Aggregate Function Based On","depends_on":"eval: doc.type === 'Document Type' &&  doc.function !== 'Count'","mandatory_depends_on":"eval: doc.type === 'Document Type' && doc.function !== 'Count'"},{"fieldname":"column_break_2","fieldtype":"Column Break"},{"fieldname":"document_type","fieldtype