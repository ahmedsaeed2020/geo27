{"name":"Auto Repeat","app":"frappe","module":"Automation","istable":0,"issingle":0,"is_submittable":0,"is_tree":0,"autoname":"format:AUT-AR-{#####}","title_field":"reference_document","search_fields":"reference_document","sort_field":"creation","fields":[{"fieldname":"reference_doctype","fieldtype":"Link","label":"Reference Document Type","options":"DocType","reqd":1,"in_list_view":1},{"fieldname":"reference_document","fieldtype":"Dynamic Link","label":"Reference Document","options":"reference_doctype","reqd":1,"no_copy":1},{"fieldname":"submit_on_creation","fieldtype":"Check","label":"Submit on Creation","default":"0"},{"fieldname":"column_break_5","fieldtype":"Column Break"},{"fieldname":"start_date","fieldtype":"Date","label":"Start Date","reqd":1,"in_list_view":1,"default":"Today"},{"fieldname":"end_date","fieldtype":"Date","label":"End Date","in_list_view":1},{"fieldname":"disabled","fieldtype":"Check","label":"Disabled","default":"0","no_copy":1},{"fieldname":"section_break_10","fieldtype":"Tab Break","label":"Schedule"},{"fieldname":"frequency","fieldtype":"Select","label":"Frequency","options":"\nDaily\nWeekly\nFortnightly\nMonthly\nQuarterly\nHalf-yearly\nYearly","reqd":1,"in_list_view":1},{"fieldname":"repeat_on_day","fieldtype":"Int","label":"Repeat on Day","depends_on":"eval: in_list([\"Monthly\", \"Quarterly\", \"Half-yearly\", \"Yearly\"], doc.frequency) && !doc.repeat_on_last_day\n"},{"fieldname":"repeat_on_last_day","fieldtype":"Check","label":"Repeat on Last Day of the Month","depends_on":"eval:doc.frequency === 'Monthly'","default":"0"},{"fieldname":"column_break_12","fieldtype":"Column Break"},{"fieldname":"next_schedule_date","fieldtype":"Date","label":"Next Schedule Date","read_only":1,"print_hide":1,"no_copy":1},{"fieldname":"section_break_looa","fieldtype":"Section Break"},{"fieldname":"generate_separate_documents_for_each_assignee","fieldtype":"Check","label":"Generate Separate Documents For Each Assignee","default":"0"},{"fieldname":"assignee","fieldtype":"Table MultiSelect","label":"Assignee","options":"Auto Repeat User"},{"fieldname":"section_break_16","fieldtype":"Section Break","depends_on":"eval:doc.frequency==='Weekly';"},{"fieldname":"repeat_on_days","fieldtype":"Table","label":"Repeat on Days","options":"Auto Repeat Day","depends_on":"eval:doc.frequency==='Weekly';"},{"fieldname":"notification","fieldtype":"Tab Break","label":"Notification"},{"fieldname":"notify_by_email","fieldtype":"Check","label":"Notify by Email","default":"0"},{"fieldname":"recipients","fieldtype":"Small Text","label":"Recipients","depends_on":"notify_by_email"},{"fieldname":"get_contacts","fieldtype":"Button","label":"Get Contacts","depends_on":"eval: doc.notify_by_email && doc.reference_doctype && doc.reference_document"},{"fieldname":"template","fieldtype":"Link","label":"Template","options":"Email Template","depends_on":"eval: doc.notify_by_email"},{"fieldname":"subject","fieldtype":"Data","label":"Subject","depends_on":"eval: doc.notify_by_email","description":"To add dynamic subject, use jinja tags like\n\n<div><pre><code>New {{ doc.doctype }} #{{ doc.name }}</code></pre></div>"},{"fieldname":"message","fieldtype":"Text","label":"Message","depends_on":"eval: doc.notify_by_email","default":"Please find attached {{ doc.doctype }} #{{ doc.name }}"},{"fieldname":"preview_message","fieldtype":"Button","label":"Preview Message","depends_on":"eval: doc.notify_by_email && doc.reference_doctype && doc.reference_document"},{"fieldname":"print_format","fieldtype":"Link","label":"Print Format","options":"Print Format","depends_on":"notify_by_email"},{"fieldname":"status","fieldtype":"Select","label":"Status","options":"\nActive\nDisabled\nCompleted","hidden":1,"read_only":1,"in_list_view":1}],"permissions":[{"create":1,"delete":1,"read":1,"role":"System Manager","write":1},{"create":1,"delete":1,"read":1,"role":"Accounts Manager","write":1},{"create":1,"delete":1,"read":1,"role":"Accounts User","write":1}],"links":[],"source":"